# Copy to .env and fill in a local PostgreSQL URL with a dedicated development login.
# Example format: postgresql://USER:PASSWORD@127.0.0.1:5432/institute_dev?schema=public
DATABASE_URL=

# Google OAuth callback for a dev server on port 3000:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate locally with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Set the actual externally used application URL, including the port.
AUTH_URL=http://localhost:3000

# Absolute path to a private persistent image directory, outside public/.
# Example for a Windows development machine: C:/Projects/institute-media
MEDIA_STORAGE_DIR=
